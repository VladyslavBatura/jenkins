				{
					"name": "Update User Profile",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Встановлюємо динамічну дату народження (наприклад, поточну дату)",
									"pm.environment.set('dateBirth', new Date().toISOString());",
									"",
									"function getRandomString(length, charset) {",
									"    let result = '';",
									"    for (let i = 0; i < length; i++) {",
									"        result += charset.charAt(Math.floor(Math.random() * charset.length));",
									"    }",
									"    return result;",
									"}",
									"",
									"function generateName(min, max) {",
									"    const charset = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';",
									"    const length = Math.floor(Math.random() * (max - min + 1)) + min;",
									"    return getRandomString(length, charset);",
									"}",
									"",
									"pm.environment.set('UpdatedName', generateName(2, 20));",
									"pm.environment.set('UpdatedLastName', generateName(2, 20));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var reqBody = JSON.parse(pm.request.body.raw);",
									"var resData = pm.response.json().data;",
									"pm.test('Profile response matches request data', function(){",
									"    pm.expect(resData.name).to.eql(reqBody.name);",
									"    pm.expect(resData.lastName).to.eql(reqBody.lastName);",
									"    pm.expect(resData.dateBirth).to.eql(reqBody.dateBirth);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "sid={{sid}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"photo\": \"user-uploaded.jpg\",\n  \"name\": \"{{UpdatedName}}\",\n  \"lastName\": \"{{UpdatedLastName}}\",\n  \"dateBirth\": \"{{dateBirth}}\",\n  \"country\": \"Ukraine\"\n}"
						},
