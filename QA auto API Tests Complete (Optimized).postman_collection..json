						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login was successful', function(){",
									"    pm.response.to.have.status(200);",
									"});",
									"var setCookieHeader = pm.response.headers.get('Set-Cookie');",
									"if(setCookieHeader) {",
									"    var sidMatch = setCookieHeader.match(/sid=([^;]+)/);",
									"    if(sidMatch) {",
									"         pm.environment.set('sid', sidMatch[1]);",
									"         console.log('Session ID extracted:', sidMatch[1]);",
									"    } else {",
									"         console.log('Cookie sid не знайдено');",
									"    }",
									"} else {",
									"    console.log('Set-Cookie заголовок відсутній');",
									"}"
								]
							}
						}
					],
