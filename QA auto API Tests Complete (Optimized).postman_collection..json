		"name": "QA auto API Tests Complete (Optimized)",
		"description": "Колекція для тестування додатку QA auto з покращеними перевірками. Використовується data-driven підхід для тестування валідації полів (як позитивних, так і негативних кейсів) одним запитом. Запити перевіряють: JSON schema, формат email, відповідність даних у запиті та відповіді (update profile), перевірку userId при зміні пароля, а також зростання вартості витрат. Колекцію можна запускати в різних середовищах (qauto та qauto2) за допомогою Collection Runner або Newman.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "40260309"
	},
	"item": [
		{
			"name": "User Tests",
			"item": [
				{
					"name": "Create User - Field Validation",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Якщо використовуємо data-driven, можна отримати тестовий кейс із pm.iterationData",
									"const testCase = pm.iterationData.toObject();",
									"",
									"// Якщо в тестових даних не передано значення, генеруємо їх динамічно",
									"function getRandomString(length, charset) {",
									"    let result = '';",
									"    for (let i = 0; i < length; i++) {",
									"        result += charset.charAt(Math.floor(Math.random() * charset.length));",
									"    }",
									"    return result;",
									"}",
									"",
									"function generateName(min, max) {",
									"    const charset = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';",
									"    const length = Math.floor(Math.random() * (max - min + 1)) + min;",
									"    return getRandomString(length, charset);",
									"}",
									"",
									"function generateEmail() {",
									"    const domains = ['example.com', 'test.com', 'mail.com'];",
									"    const username = generateName(5, 10).toLowerCase();",
									"    const domain = domains[Math.floor(Math.random() * domains.length)];",
									"    return `${username}@${domain}`;",
									"}",
									"",
									"pm.environment.set('nameInput', testCase.nameInput || generateName(2, 20));",
									"pm.environment.set('lastNameInput', testCase.lastNameInput || generateName(2, 20));",
									"pm.environment.set('emailInput', testCase.emailInput || generateEmail());",
									"pm.environment.set('passwordInput', testCase.passwordInput || 'Qwerty12345');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"// JSON Schema перевірка",
									"const schema = {",
									"  type: 'object',",
									"  required: ['status', 'data'],",
									"  properties: {",
									"    status: { type: 'string' },",
									"    data: {",
									"      type: 'object',",
									"      required: ['userId', 'photoFilename', 'distanceUnits', 'currency'],",
									"      properties: {",
									"        userId: { type: 'number' },",
									"        photoFilename: { type: 'string' },",
									"        distanceUnits: { type: 'string' },",
									"        currency: { type: 'string' }",
									"      }",
									"    }",
									"  }",
									"};",
									"pm.test('Response matches JSON schema', function () {",
									"    pm.response.to.have.jsonSchema(schema);",
									"});",
									"",
									"// Перевірка формату email",
									"const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
									"const email = pm.environment.get('emailInput');",
									"pm.test('Email is valid', function () {",
									"    pm.expect(email).to.match(emailRegex);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.status === 'error') {",
									"  pm.test('Error message contains validation info', function () {",
									"    pm.expect(jsonData.message).to.match(/(порожне|один|декілька)/i);",
									"  });",
									"} else {",
									"  pm.environment.set('userId', jsonData.data.userId);",
									"  // Витягуємо sid з Set-Cookie",
									"  var setCookieHeader = pm.response.headers.get('Set-Cookie');",
									"  if (setCookieHeader) {",
									"    var sidMatch = setCookieHeader.match(/sid=([^;]+)/);",
									"    if (sidMatch) {",
									"      pm.environment.set('sid', sidMatch[1]);",
									"      console.log('sid extracted:', sidMatch[1]);",
									"    }",
									"  }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{nameInput}}\",\n  \"lastName\": \"{{lastNameInput}}\",\n  \"email\": \"{{emailInput}}\",\n  \"password\": \"{{passwordInput}}\",\n  \"repeatPassword\": \"{{passwordInput}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/signup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"signup"
							]
						}
					},
					"response": []
				},
				{
